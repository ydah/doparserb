# define DOPA_BEGIN() ((void) 0)
# define DOPA_FLUSH() ((void) 0)
# define DOPA_TOKEN(sym, loc) ((void) 0)
# define DOPA_SHIFT(sym, state, depth) ((void) 0)
# define DOPA_REDUCE(rule, len, state, depth) ((void) 0)
# define DOPA_ERROR(state, sym, loc) ((void) 0)
# define DOPA_POP(n, depth) ((void) 0)
# define DOPA_ERROR_SHIFT(state, depth) ((void) 0)
# define DOPA_REPAIR_PLAN(n) ((void) 0)
# define DOPA_REPAIR_TOKEN(sym) ((void) 0)
# define DOPA_REPAIR_DONE() ((void) 0)
# define DOPA_ACCEPT() ((void) 0)
# define DOPA_ABORT() ((void) 0)
# define DOPA_EXHAUSTED() ((void) 0)
# define DOPA_END() ((void) 0)
