#  define yydopa_line(loc) ((loc)->first_line)
#  define yydopa_column(loc) ((loc)->first_column)
# else
#  define yydopa_line(loc) 0
#  define yydopa_column(loc) 0
# endif
# define DOPA_DECL() struct yydopa_context yydopa
# define DOPA_BEGIN() yydopa_begin(&yydopa)
# define DOPA_FLUSH() do { if (yydopa.on) { if (yydopa.eager) yydopa_flush(&yydopa); } } while (0)
# define DOPA_TOKEN(sym, loc) do { if (yydopa.on) yydopa_event(&yydopa, 'T', 3, (long) (sym), yydopa_line(loc), yydopa_column(loc), 0); } while (0)
# define DOPA_SHIFT(sym, state, depth) do { if (yydopa.on) yydopa_event(&yydopa, 'S', 3, (long) (sym), (long) (state), (long) (depth), 0); } while (0)
# define DOPA_REDUCE(rule, len, state, depth) do { if (yydopa.on) yydopa_event(&yydopa, 'R', 4, (long) (rule), (long) (len), (long) (state), (long) (depth)); } while (0)
# define DOPA_ERROR(state, sym, loc) do { if (yydopa.on) yydopa_event(&yydopa, 'E', 4, (long) (state), (long) (sym), yydopa_line(loc), yydopa_column(loc)); } while (0)
# define DOPA_POP(n, depth) do { if (yydopa.on) yydopa_event(&yydopa, 'P', 2, (long) (n), (long) (depth), 0, 0); } while (0)
# define DOPA_ERROR_SHIFT(state, depth) do { if (yydopa.on) yydopa_event(&yydopa, 'X', 2, (long) (state), (long) (depth), 0, 0); } while (0)
# define DOPA_REPAIR_PLAN(n) do { if (yydopa.on) yydopa_event(&yydopa, 'Q', 1, (long) (n), 0, 0, 0); } while (0)
# define DOPA_REPAIR_TOKEN(sym) do { if (yydopa.on) yydopa_event(&yydopa, 'I', 1, (long) (sym), 0, 0, 0); } while (0)
# define DOPA_REPAIR_DONE() do { if (yydopa.on) yydopa_event(&yydopa, 'C', 0, 0, 0, 0, 0); } while (0)
# define DOPA_ACCEPT() do { if (yydopa.on) yydopa_event(&yydopa, 'A', 0, 0, 0, 0, 0); } while (0)
# define DOPA_ABORT() do { if (yydopa.on) yydopa_event(&yydopa, 'Z', 0, 0, 0, 0, 0); } while (0)
# define DOPA_EXHAUSTED() do { if (yydopa.on) yydopa_event(&yydopa, 'O', 0, 0, 0, 0, 0); } while (0)
# define DOPA_END() do { if (yydopa.on) yydopa_end(&yydopa); } while (0)
#endif
